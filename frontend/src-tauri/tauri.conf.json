{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chime",
  "version": "1.0.0",
  "identifier": "com.chime.cashback",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chime - Credit Card Cashback Tracker",
        "width": 1280,
        "height": 830,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "targets": "all",
    "externalBin": [
      "binaries/chime-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
